# Server-only configuration. Never expose these values through VITE_* variables.
APP_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=generate-a-Fernet-key-and-keep-it-stable
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/callback
FRONTEND_ORIGIN=https://YOUR-DOMAIN
DATABASE_PATH=/var/data/app.sqlite3
MAX_UPLOAD_BYTES=268435456

# Generate keys locally (do not send them in chat):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Google Cloud: enable YouTube Data API v3 and YouTube Analytics API, then add the exact
# redirect URI above to the OAuth web client. Use HTTPS in production.